# CYBER//BREACH backend — copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://username:password@host:5432/database
DATABASE_SSL=
# In-memory Postgres emulator for tests (no server needed)
TEST_DB_MEM=0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Seed script guard (development only)
ALLOW_SEED=true
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=Demo1234!
SEED_DEMO_CODENAME=NEXUS

AI_ENABLED=false
